{
  "name": "sha7ntec",
  "version": "1.0.0",
  "private": true,
  "description": "Sha7ntec — logistics financial-control middleware",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:keys && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:keys": "node scripts/check-no-server-keys.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "verify:rls": "tsx --env-file=.env.local scripts/verify-rls.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}
