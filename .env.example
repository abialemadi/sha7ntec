# ============================================================
# Sha7ntec environment variables
# Copy to .env.local for local dev, and set in Vercel project settings.
# ============================================================

# --- Public (safe to expose in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVER ONLY — never prefix these with NEXT_PUBLIC_ ---
# If any of these leak into the client bundle, `npm run build` fails
# (see scripts/check-no-server-keys.mjs).
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OILPRICE_API_KEY=
